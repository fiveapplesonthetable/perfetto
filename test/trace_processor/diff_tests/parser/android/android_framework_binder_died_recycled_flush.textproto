# Same events as android_framework_binder_died_recycled, but with the
# periodic flush + read-buffer service events of a long trace
# (write_into_file + flush_period_ms): the sorter extracts and parses the
# process events before the trace-stop dump is even tokenized.
packet {
  trace_config {
    data_sources {
      config {
        name: "android.process_state"
        android_process_state_config { dump_process_metadata: true }
      }
    }
  }
  trusted_uid: 9999
  trusted_packet_sequence_id: 3
}
packet {
  clock_snapshot {
    primary_trace_clock: BUILTIN_CLOCK_BOOTTIME
    clocks { clock_id: 6 timestamp: 0 }
    clocks { clock_id: 3 timestamp: 0 }
  }
  trusted_uid: 9999
  trusted_packet_sequence_id: 1
}
packet {
  timestamp: 1000000000
  trusted_packet_sequence_id: 1
  track_event {
    type: TYPE_INSTANT
    name: "process_start"
    [com.android.internal.FrameworksBaseTrackEvent.process_start_event] {
      uid: 10001
      pid: 100
      process_name: "com.example.appa"
      start_seq_id: 1
    }
  }
}
packet {
  timestamp: 1500000000
  trusted_packet_sequence_id: 2
  service_event { all_data_sources_flushed: true }
}
packet {
  timestamp: 1500000001
  trusted_packet_sequence_id: 2
  service_event { read_tracing_buffers_completed: true }
}

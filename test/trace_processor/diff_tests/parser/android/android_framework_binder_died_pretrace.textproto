# App A (pid 100) was started before the trace, so there is no
# process_start for it; it is known only via its own track descriptor.
# pid 100 is then recycled by App B (seq 2) and App A's death (seq 1) is
# reported late. App B must not be merged with App A nor ended by it.
packet {
  trace_config {
    data_sources {
      config {
        name: "android.process_state"
        android_process_state_config { dump_process_metadata: true }
      }
    }
  }
  trusted_uid: 9999
  trusted_packet_sequence_id: 3
}
packet {
  clock_snapshot {
    primary_trace_clock: BUILTIN_CLOCK_BOOTTIME
    clocks { clock_id: 6 timestamp: 0 }
    clocks { clock_id: 3 timestamp: 0 }
  }
  trusted_uid: 9999
  trusted_packet_sequence_id: 1
}
packet {
  timestamp: 500000000
  trusted_packet_sequence_id: 3
  track_descriptor {
    uuid: 1000
    process { pid: 100 process_name: "com.example.appa" }
  }
}
packet {
  timestamp: 5000000000
  trusted_packet_sequence_id: 1
  track_event {
    type: TYPE_INSTANT
    name: "process_start"
    [com.android.internal.FrameworksBaseTrackEvent.process_start_event] {
      uid: 10002
      pid: 100
      process_name: "com.example.appb"
      start_seq_id: 2
    }
  }
}
packet {
  timestamp: 6000000000
  trusted_packet_sequence_id: 1
  track_event {
    type: TYPE_INSTANT
    name: "binder_died"
    [com.android.internal.FrameworksBaseTrackEvent.binder_died_event] {
      uid: 10001
      pid: 100
      process_name: "com.example.appa"
      start_seq_id: 1
    }
  }
}
packet {
  timestamp: 10000000000
  [com.android.internal.FrameworksBaseTracePacket.android_process_state] {
    record {
      pid: 100
      uid: 10002
      process_name: "com.example.appb"
      start_seq_id: 2
      proc_state: 1002
      oom_score: 100
    }
  }
}

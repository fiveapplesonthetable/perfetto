# Small heap graph for exercising _heap_graph_object_reference_tree.
#
# Reference edges (owner -> owned), class names in brackets:
#
#        R[10] ---> A[20] ---> B[30] ---> D[50]
#                    |  \                  ^  |
#        E[60] ------+   \--> C[40] -------/  |
#                                  ^----------+   (D -> B : a cycle)
#
# i.e.
#   R -> A
#   E -> A            (E is an unreachable object that still references A)
#   A -> B, A -> C
#   B -> D, C -> D    (D is reachable from A via TWO equal-length paths)
#   D -> B            (B -> D -> B is a cycle)
#   W -> D            (W is a java.lang.ref.WeakReference whose referent is D;
#                      it must be EXCLUDED, so W never appears in D's incoming
#                      tree even though it references D)
#
# This lets a BFS rooted at A (outgoing) prove D appears once, and a BFS rooted
# at D (incoming) prove the cycle and the multi-path both collapse to a single
# shortest parent.
packet {
  process_tree {
    processes {
      pid: 2
      ppid: 1
      cmdline: "system_server"
      uid: 1000
    }
  }
}
packet {
  trusted_packet_sequence_id: 999
  timestamp: 10
  [com.android.art.tracing.ArtHeapGraphTracePacket.heap_graph] {
    pid: 2
    roots {
      root_type: ROOT_JNI_GLOBAL
      object_ids: 0x01  # R
    }
    objects {
      id: 0x01
      type_id: 1
      self_size: 10
      reference_object_id: 0x02
    }
    objects {
      id: 0x02
      type_id: 2
      self_size: 20
      reference_object_id: 0x03
      reference_object_id: 0x04
    }
    objects {
      id: 0x03
      type_id: 3
      self_size: 30
      reference_object_id: 0x05
    }
    objects {
      id: 0x04
      type_id: 4
      self_size: 40
      reference_object_id: 0x05
    }
    objects {
      id: 0x05
      type_id: 5
      self_size: 50
      reference_object_id: 0x03
    }
    objects {
      id: 0x06
      type_id: 6
      self_size: 60
      reference_object_id: 0x02
    }
    objects {
      id: 0x07
      type_id: 7  # WeakReference; its referent (D) edge is excluded
      self_size: 70
      reference_object_id: 0x05
    }
    types {
      id: 1
      class_name: "R"
      location_id: 1
    }
    types {
      id: 2
      class_name: "A"
      location_id: 1
    }
    types {
      id: 3

      location_id: 1
    }
    types {
      id: 6
      class_name: "E"
      location_id: 1
    }
    types {
      id: 7
      class_name: "W"
      kind: KIND_WEAK_REFERENCE
      reference_field_id: 100
      location_id: 1
    }
    field_names {
      iid: 100
      str: "java.lang.ref.Reference.referent"
    }
    continued: false
    index: 1
  }
}
